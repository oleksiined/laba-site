{
  "functions": {
    "api/order.js":        { "maxDuration": 10 },
    "api/sync-catalog.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path":     "/api/sync-catalog",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ],
  "routes": [
    {
      "src":  "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src":  "/(.*)",
      "has":  [{ "type": "host", "value": "admin\\.laba\\.zemlerob\\.com\\.ua" }],
      "dest": "/admin.html"
    }
  ]
}
